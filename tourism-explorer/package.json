{
  "name": "@hyperdart/tourismexplorer",
  "version": "1.0.0",
  "description": "Standalone hyperDart Tourism Explorer component answering travel intent with attractions, categories, weather, day plans, and interactive maps.",
  "main": "dist/index.umd.cjs",
  "module": "dist/index.js",
  "private": false,
  "type": "module",
  "publishConfig": {
    "registry": "https://dev-registry.hyperdart.com",
    "access": "public"
  },
  "files": [
    "dist",
    "hyperdart.config.js",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "node tests/tourism.test.js",
    "validate": "node scripts/validate-publish.js",
    "prepublishOnly": "node scripts/validate-publish.js"
  },
  "keywords": [
    "hyperdart",
    "tourism",
    "travel",
    "attractions",
    "sights",
    "museums",
    "landmarks"
  ],
  "author": "Tourism Explorer Developer",
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.1.0"
  }
}
